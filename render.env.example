# Enter these in Render's Environment settings. Never commit real credentials.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=
SUPABASE_SECRET_KEY=
ADMIN_EMAIL=info@adepapay.com
ADMIN_PASSWORD=
VIRESEND_API_KEY=
# The Blueprint generates this automatically; keep it stable across restarts.
FLASK_SECRET_KEY=
APP_ORIGIN=https://adepapay.com
# Enable only on the production domain. Leave false on staging/preview services.
SEO_INDEXING=false
# Optional actual Search Console URL-prefix verification token.
GOOGLE_SITE_VERIFICATION=
COOKIE_SECURE=true
CF_ACCOUNT_ID=
CF_IMAGES_TOKEN=
CF_HASH=
CF_IMAGES_VARIANT=public
# Configure both keys to enable subscription checkout.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
WEB_CONCURRENCY=2
GUNICORN_THREADS=4

# Enable only after Cloudflare Images > Hosted Images > Delivery > Flexible variants.
CF_IMAGES_RESPONSIVE=false
